# Sandbox directory for agent file/shell operations (must be inside project root)
# Default: ./sandbox
# SANDBOX_DIR=./sandbox

# LLM Provider: deepseek | lmstudio (default: lmstudio)
LLM_PROVIDER=lmstudio

# Model name override
# LLM_MODEL=deepseek-chat
# LLM_MODEL=local-model

# DeepSeek API key (required when LLM_PROVIDER=deepseek)
# DEEPSEEK_API_KEY=sk-...

# LM Studio base URL (default: http://localhost:1234/v1)
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
