# Infrastructure settings only.
# User preferences (provider, model, etc.) live in data/users/<name>/config.json

# Sandbox directory for file operations (must be inside project root)
# Default: ./sandbox
# SANDBOX_DIR=./sandbox

# DeepSeek API key — use this if you don't want to store the key in config.json
# DEEPSEEK_API_KEY=sk-...

# LM Studio base URL (default: http://localhost:1234/v1)
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# DeepSeek base URL (default: https://api.deepseek.com)
# DEEPSEEK_BASE_URL=https://api.deepseek.com
